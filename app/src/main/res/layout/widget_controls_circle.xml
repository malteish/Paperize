<?xml version="1.0" encoding="utf-8"?>
<!-- All four widget buttons as the quarters of one 106dp circle, split by a 2dp cross:
     change top-left, pause/resume top-right, copy to premium bottom-left, open image
     bottom-right. Each quarter is its own ImageView so it can carry its own click target;
     the tap area of a quarter is its square, including the corner outside the circle.
     Fixed sizes keep the quarters aligned, which wrap_content shrinking could not
     guarantee. The pause/resume src is only the widget-picker preview default. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_change"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_margin="1dp"
            android:src="@drawable/ic_widget_quadrant_next"
            android:contentDescription="@string/change_wallpaper_now" />

        <ImageView
            android:id="@+id/widget_pause_resume"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_margin="1dp"
            android:src="@drawable/ic_widget_quadrant_pause"
            android:contentDescription="@string/pause_wallpaper_changes" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_premium"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_margin="1dp"
            android:src="@drawable/ic_widget_quadrant_premium"
            android:contentDescription="@string/copy_to_premium_folder" />

        <ImageView
            android:id="@+id/widget_open"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_margin="1dp"
            android:src="@drawable/ic_widget_quadrant_open"
            android:contentDescription="@string/open_in_gallery" />

    </LinearLayout>

</LinearLayout>
