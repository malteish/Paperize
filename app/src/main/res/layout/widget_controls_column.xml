<?xml version="1.0" encoding="utf-8"?>
<!-- All four widget buttons stacked in a 1x2 widget.
     Each ImageView takes an equal quarter of the widget's height and the full width,
     so its tap target is that whole slice (about 40dp tall and the full cell width on a typical
     launcher), not just the drawn icon. centerInside scales the round icon to the slice's
     shorter side minus the 3dp padding, which also keeps the icons apart. The pause/resume
     src is only the widget-picker preview default; the provider swaps it to match the
     changer state. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/widget_change"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingVertical="3dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_widget_next"
        android:contentDescription="@string/change_wallpaper_now" />

    <ImageView
        android:id="@+id/widget_pause_resume"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingVertical="3dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_widget_pause"
        android:contentDescription="@string/pause_wallpaper_changes" />

    <ImageView
        android:id="@+id/widget_premium"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingVertical="3dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_widget_premium"
        android:contentDescription="@string/copy_to_premium_folder" />

    <ImageView
        android:id="@+id/widget_open"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingVertical="3dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_widget_open"
        android:contentDescription="@string/open_in_gallery" />

</LinearLayout>
