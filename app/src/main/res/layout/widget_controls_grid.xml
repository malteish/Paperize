<?xml version="1.0" encoding="utf-8"?>
<!-- All four widget buttons in a 2x2 grid: change and pause/resume on top, copy to
     premium and open image below. Sized like the row/column widgets: icons capped at the
     56dp of the single-button widgets, 3dp apart, grouped in the centre. The pause/resume
     src is only the widget-picker preview default; the provider swaps it to match the
     changer state. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_change"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="3dp"
            android:adjustViewBounds="true"
            android:maxWidth="56dp"
            android:maxHeight="56dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_next"
            android:contentDescription="@string/change_wallpaper_now" />

        <ImageView
            android:id="@+id/widget_pause_resume"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="3dp"
            android:adjustViewBounds="true"
            android:maxWidth="56dp"
            android:maxHeight="56dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_pause"
            android:contentDescription="@string/pause_wallpaper_changes" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_premium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="3dp"
            android:adjustViewBounds="true"
            android:maxWidth="56dp"
            android:maxHeight="56dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_premium"
            android:contentDescription="@string/copy_to_premium_folder" />

        <ImageView
            android:id="@+id/widget_open"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="3dp"
            android:adjustViewBounds="true"
            android:maxWidth="56dp"
            android:maxHeight="56dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_open"
            android:contentDescription="@string/open_in_gallery" />

    </LinearLayout>

</LinearLayout>
